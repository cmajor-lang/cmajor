## testFunction()

//==============================================================================
// complex32/complex64 scalar folding

static_assert (-(1.0f + 2.0fi) == complex32 (-1.0f, -2.0f));
static_assert (-(1.0  + 2.0i)  == complex64 (-1.0, -2.0));

static_assert ((1.0f + 2.0fi) + (3.0f + 4.0fi) == complex32 (4.0f, 6.0f));
static_assert ((1.0f + 2.0fi) - (3.0f + 4.0fi) == complex32 (-2.0f, -2.0f));
static_assert ((1.0f + 2.0fi) * (3.0f + 4.0fi) == complex32 (-5.0f, 10.0f));
static_assert ((4.0f + 0.0fi) / (2.0f + 0.0fi) == complex32 (2.0f, 0.0f));

static_assert ((1.0 + 2.0i) * (3.0 + 4.0i) == complex64 (-5.0, 10.0));
static_assert ((1.0f + 2.0fi) != (1.0f + 3.0fi));
static_assert (-(0.0f + 0.0fi) == complex32 (0.0f, 0.0f));

// a complex64 constant folded down to complex32 and back
static_assert (complex32 (1.0 + 2.0i) == complex32 (1.0f, 2.0f));
static_assert (complex64 (1.0f + 2.0fi) == complex64 (1.0, 2.0));

//==============================================================================
// vector folding - these go through the aggregate constant's unary-op handling,
// then the folded vector is indexed to get a scalar back out

static_assert ((-float<2> (1.0f, 2.0f))[0] == -1.0f);
static_assert ((-float<2> (1.0f, 2.0f))[1] == -2.0f);
static_assert ((-float64<2> (1.0, 2.0))[1] == -2.0);
static_assert ((-int<3> (1, 2, 3))[2] == -3);
static_assert ((-int64<2> (1L, 2L))[1] == -2L);

static_assert ((-complex32<2> (1.0f + 2.0fi, 3.0f))[0] == complex32 (-1.0f, -2.0f));
static_assert ((-complex32<2> (1.0f + 2.0fi, 3.0f))[1] == complex32 (-3.0f, 0.0f));
static_assert ((-complex64<2> (1.0 + 2.0i, 3.0))[0] == complex64 (-1.0, -2.0));

static_assert ((! bool<2> (true, false))[0] == false);
static_assert ((! bool<2> (true, false))[1] == true);

static_assert ((~int<2> (1, 2))[0] == -2);
static_assert ((~int<2> (1, 2))[1] == -3);

// negative indices wrap round to the end of a folded vector
static_assert ((-int<3> (1, 2, 3))[-1] == -3);

//==============================================================================
// a size-1 vector constant collapsing to a scalar

static_assert (int<1> (7) == 7);
static_assert (int64<1> (7L) == 7L);
static_assert (float<1> (2.5f) == 2.5f);
static_assert (float64<1> (2.5) == 2.5);
static_assert (bool<1> (true) == true);
static_assert (complex32<1> (1.0f + 2.0fi) == complex32 (1.0f, 2.0f));
static_assert (complex64<1> (1.0 + 2.0i) == complex64 (1.0, 2.0));

//==============================================================================
// wrap/clamp constants

static_assert (wrap<10> (12) == 2);
static_assert (wrap<10> (-1) == 9);
static_assert (clamp<10> (12) == 9);
static_assert (clamp<10> (-5) == 0);

//==============================================================================
// string and enum constants

static_assert ("abc" == "abc");
static_assert ("abc" != "abd");

bool test() { return true; }

## testFunction()

enum Colour { red, green, blue }

static_assert (Colour::red == Colour::red);
static_assert (Colour::red != Colour::green);

const Colour chosen = Colour::blue;
static_assert (chosen == Colour::blue);

bool testEnumConstants()
{
    const Colour c = Colour::green;
    static_assert (c != Colour::red);
    return true;
}
