// These tests check that the statements which a user would expect to be able to put
// a breakpoint on have an entry in the debug line table. Many of them get replaced by
// generated code during compilation, which must keep the location of the original.

## testBreakpointLines()

processor P [[ main ]]
{
    input stream float in;
    output stream float out;

    void main()
    {
        loop
        {
            let x = in * 0.5f;      //@break
            out <- x;               //@break
            advance();              //@break
        }
    }
}

## testBreakpointLines()

processor P [[ main ]]
{
    output stream float out;
    var count = 0;

    void main()
    {
        out <- 0.0f;                //@break
        advance();                  //@break

        loop
        {
            out <- 1.0f;            //@break
            advance();              //@break

            if (++count % 2 == 0)   //@break
                advance();          //@break

            out <- 2.0f;            //@break
            advance();              //@break
        }
    }
}

## testBreakpointLines()

processor P [[ main ]]
{
    output stream float out;

    void main()
    {
        for (int i = 0; i < 10; ++i)    //@break
        {
            out <- float (i);           //@break
            advance();                  //@break
        }

        return;                         //@break
    }
}

## testBreakpointLines()

graph G [[ main ]]
{
    output stream float<2> out;
    output stream float multi;
    output stream complex32 c;
    output value float level;

    node p = P;

    connection
    {
        p.out -> out;
        p.multi[1] -> multi;
        p.c -> c;
        p.level -> level;
    }
}

processor P
{
    output stream float<2> out;
    output stream float multi[2];
    output stream complex32 c;
    output value float level;

    void main()
    {
        loop
        {
            out <- float<2> (1.0f, 2.0f);   //@break
            multi[1] <- 3.0f;               //@break
            multi <- 4.0f;                  //@break
            c <- complex32 (1.0f, 2.0f);    //@break
            level <- 0.5f;                  //@break
            advance();                      //@break
        }
    }
}

## testBreakpointLines()

graph G [[ main ]]
{
    output event int e;
    output event int multi;

    node p = P;

    connection
    {
        p.e -> e;
        p.multi[0] -> multi;
    }
}

processor P
{
    output event int e;
    output event int multi[2];

    void main()
    {
        loop
        {
            e <- 1;             //@break
            multi[0] <- 2;      //@break
            multi <- 3;         //@break
            advance();          //@break
        }
    }
}

## testBreakpointLines()

processor P [[ main ]]
{
    input event float gainIn;
    output stream float out;

    float gain = 1.0f;

    event gainIn (float newGain)
    {
        gain = newGain;                 //@break
    }

    float scale (float x)
    {
        let y = x * gain;               //@break
        return y;                       //@break
    }

    void main()
    {
        loop
        {
            out <- scale (1.0f);        //@break
            advance();                  //@break
        }
    }
}

## testBreakpointLines()

processor Inner
{
    output stream float out;

    void main()
    {
        loop
        {
            out <- 1.0f;            //@break
            advance();              //@break
        }
    }
}

processor Outer [[ main ]]
{
    output stream float out;
    node inner = Inner;
    node inners = Inner[2];

    void main()
    {
        loop
        {
            inner.advance();        //@break
            inners.advance();       //@break
            out <- inner.out;       //@break
            advance();              //@break
        }
    }
}
